# Demo values for CI and every automated test. They point at the Firebase Emulator Suite
# (project demo-todo) and never at a real project. Contains no secrets.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-todo.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAINS=demo-todo.web.app,demo-todo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-todo
VITE_FIREBASE_STORAGE_BUCKET=demo-todo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_VAPID_KEY=demo-vapid-key
VITE_USE_EMULATORS=true
