.DS_Store
node_modules
/dist
# Source maps from the production build: kept for error tracking, never deployed or committed.
/sourcemaps

# local env files
.env
.env.local
.env.*.local
# Cloud Functions params: functions/.env.example documents them; the deploy workflow writes .env
functions/.env
functions/.env.*
!functions/.env.example
# Service account keys: never committed (the deploy key lives in a GitHub environment secret)
*-firebase-adminsdk-*.json
spanion-todo-*.json
service-account*.json

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*-debug.log
firebase-debug.log

# Firebase CLI deploy caches
.firebase/

# Test output
/coverage
/playwright-report
/test-results
# The visual harness's latest captures (the references in refs/ and the comparisons are committed)
/design/modernize/*/app/

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.apk
*.aab
signing-key-info.txt
*.keystore

# Android (TWA) build outputs and Gradle caches: the source and its Readme stay tracked
packages/android/source/.gradle/
packages/android/source/build/
packages/android/source/app/build/
packages/android/source/local.properties
*.idsig

# Local tooling: Claude Code worktrees and the ga run workspace
.claude/worktrees/
.ga/runs/
