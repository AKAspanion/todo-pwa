# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > SDK config.
VUE_APP_API_KEY=
VUE_APP_AUTH_DOMAIN=
VUE_APP_DATABASE_URL=
VUE_APP_PROJECT_ID=
VUE_APP_STORAGE_BUCKET=
VUE_APP_MESSAGING_SENDER_ID=
VUE_APP_APP_ID=
# Cloud Messaging > Web Push certificates (needed for push notifications only)
VUE_APP_VAPID_KEY=
