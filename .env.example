# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > SDK config.
# Leave VITE_USE_EMULATORS=true for local development against the Firebase Emulator Suite
# (firebase emulators:start --project demo-todo); set it to false only to use a real project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# The app's Hosting domains, comma-separated. On one of them the app uses the page's own host as
# its auth domain (same-origin Google sign-in); anywhere else, VITE_FIREBASE_AUTH_DOMAIN.
# Live: todo.spanion.in,spanion-todo.web.app,spanion-todo.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAINS=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging > Web Push certificates (needed for push notifications only)
VITE_FIREBASE_VAPID_KEY=
VITE_USE_EMULATORS=true
