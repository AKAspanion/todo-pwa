{
  "name": "todo-pwa",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "firebase emulators:exec --project demo-todo --only auth,firestore --ui --import=./.emulator-data --export-on-exit=./.emulator-data \"vite --mode emulators\"",
    "dev:app": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:functions": "firebase deploy --only functions",
    "test": "sh -c 'firebase emulators:exec --project demo-todo --only auth,firestore \"vitest run $*\"' --",
    "twa:update": "cd packages/android && npx --yes @bubblewrap/cli@1.27.0 update --skipVersionUpgrade",
    "twa:build": "cd packages/android && npx --yes @bubblewrap/cli@1.27.0 build",
    "test:rules": "sh -c 'firebase emulators:exec --project demo-todo --only firestore \"vitest run tests/rules $*\"' --",
    "e2e": "sh -c 'firebase emulators:exec --project demo-todo --only auth,firestore \"playwright test $*\"' --"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "firebase": "^13.1.0",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.17",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "firebase-tools": "^15.34.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}