{
  "name": "functions",
  "description": "Cloud Functions for Firebase: push reminders and the budget kill-switch (Node 22, v2 API)",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "test": "sh -c '../node_modules/.bin/firebase emulators:exec --project demo-todo --only firestore \"vitest run $*\"' --",
    "migrate": "tsx scripts/migrate-legacy.ts",
    "deploy": "../node_modules/.bin/firebase deploy --only functions",
    "logs": "../node_modules/.bin/firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
