# Cloud Functions params (firebase-functions/params), read by `firebase deploy`.
# Copy to functions/.env to deploy by hand. The deploy workflow (.github/workflows/deploy.yml)
# writes functions/.env from the production environment's APP_URL variable.

# The web app's address, without a trailing slash. Reminder notifications show its icon,
# <APP_URL>/img/icons/android-chrome-192x192.png. Defaults to https://spanion-todo.web.app.
APP_URL=https://spanion-todo.web.app
